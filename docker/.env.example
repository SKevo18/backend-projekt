# Database passwords
DB_ROOT_PASSWORD=your_root_password_here
DB_PASSWORD=your_app_password_here

# Optional: customize database name and user
DB_NAME=app
DB_USER=app

# JWT Secret Key (generate a random string for production)
SECRET_KEY=change_me_in_production

# Frontend URL for CORS (default: http://localhost for Docker)
FRONTEND_URL=http://localhost
